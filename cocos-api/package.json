{
  "name": "cocos-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/src/main.js",
    "dev": "nodemon",
    "build": "rimraf dist && tsc --project tsconfig.json",
    "docker:deploy": "npm run build && docker-compose up",
    "test": "jest --rootDir=./tests --config=./tests/jest.config.js"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "ts-node src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.721.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.2",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "rimraf": "^6.0.1",
    "sqs-producer": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@jest/globals": "^29.7.0",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.8.0",
    "globals": "^15.8.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
