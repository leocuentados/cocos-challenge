							"name": "search instruments by name",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"const jsonData = pm.response.json();\r",
											"\r",
											"// Itera sobre todos los elementos del array y verifica que el nombre comience con \"Grupo\"\r",
											"jsonData.forEach(item => {\r",
											"    pm.test(`instrument ${item.id} has name starting with \"grupo\"`, function () {\r",
											"         pm.expect(item.name).to.match(/^grupo/i);\r",
											"    });\r",
											"});"
										],
										"type": "text/javascript",
										"packages": {}
									}
