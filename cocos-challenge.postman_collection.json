											"pm.test(`instrument search by specific ticker has exactly one result`, () => {\r",
											"    pm.expect(jsonData.length).to.equal(1);\r",
											"})\r",
											"\r",
											"// Itera sobre todos los elementos del array y verifica que el nombre comience con \"Grupo\"\r",
											"jsonData.forEach(item => {\r",
											"    pm.test(`instrument ${item.id} has ticker starting with \"GGAL\"`, function () {\r",
											"         pm.expect(item.ticker).to.match(/^GGAL/); // Verifica el ticker, no el name\r",
											"    });\r",
											"});"
